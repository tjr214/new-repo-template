{
  "name": "@generated/mobile",
  "private": true,
  "version": "0.0.0",
  "main": "index.js",
  "dependencies": {
    "expo": "^55.0.4",
    "expo-status-bar": "^55.0.4",
    "react": "^19.2.4",
    "react-native": "^0.84.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "dev": "bun run mobile:start:smoke",
    "build": "bun run mobile:export:smoke",
